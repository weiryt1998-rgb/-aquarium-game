# ใช้กับ Firebase Emulator ในเครื่องเท่านั้น (npm run dev:emulators) — ไม่มีข้อมูลลับ ไม่แตะโปรเจกต์จริง
# project id ที่ขึ้นต้นด้วย demo- จะไม่เชื่อมต่อบริการ Firebase จริงเด็ดขาด
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-aquarium.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-aquarium
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
VITE_GAME_ACCOUNT_EMAIL=player@aquarium.test
VITE_CLOUD_SAVE_MODE=rules
VITE_FIREBASE_FUNCTIONS_REGION=asia-southeast1
VITE_USE_FIREBASE_EMULATORS=true
