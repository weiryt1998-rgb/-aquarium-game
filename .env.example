# ค่าตั้งเซฟกลาง (Firebase) — คัดลอกเป็นไฟล์ .env.local แล้วใส่ค่าจริง (ไฟล์ .env.local ไม่ถูก commit)
# บน Netlify / GitHub Actions ให้ตั้งเป็น Environment variables ชื่อเดียวกันแทน
#
# ค่า VITE_* ถูกฝังลงหน้าเว็บ → ใส่ได้เฉพาะค่าที่เปิดเผยได้ (Firebase web config ไม่ใช่ความลับ)
# ห้ามใส่รหัสผ่านเกม, service account JSON หรือ private key ในไฟล์นี้เด็ดขาด

# Firebase Console → Project settings → General → Your apps → Web app → SDK setup and configuration (Config)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_STORAGE_BUCKET=

# อีเมลของ "บัญชีผู้เล่นหลัก" ที่สร้างใน Firebase Authentication (เป็นแค่ชื่อบัญชี ไม่ใช่ความลับ)
# รหัสผ่านเกมตั้งที่ Firebase Authentication เท่านั้น ห้ามใส่ที่นี่
VITE_GAME_ACCOUNT_EMAIL=player@your-domain.example

# rules = แผน Spark ฟรี (ค่าเริ่มต้น, ไม่ใช้ Cloud Functions) — เว้นบรรทัดนี้ไว้ได้
# (functions = แผน Blaze เท่านั้น ดูภาคผนวกใน docs/CLOUD_SAVE.md)
VITE_CLOUD_SAVE_MODE=rules
