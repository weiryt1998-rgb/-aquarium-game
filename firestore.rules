rules_version = '2';

// Security Rules ของเซฟกลาง — แผน Spark (ฟรี ไม่มี Cloud Functions) · ค่าเริ่มต้นของโปรเจกต์
//
// หน้าเว็บเขียนเซฟเองผ่าน Firestore transaction โดยใช้กฎเกมชุดเดียวกัน (src/shared/) และ Rules นี้บังคับว่า:
// - ต้องเข้าสู่ระบบด้วย "บัญชีผู้เล่นหลัก" เท่านั้น (เทียบ UID ตรงตัวใน playerUid() ข้างล่าง)
// - revision ต้องเพิ่มทีละ 1 จากค่าบนเซิร์ฟเวอร์ → เขียนทับด้วยข้อมูลที่อ่านมาเก่าไม่ได้ (กันข้อมูลหาย)
// - updatedAt ต้องเป็นเวลาของเซิร์ฟเวอร์, createdAt ห้ามเปลี่ยน, ห้ามลบเซฟ
// - โครงสร้างและช่วงค่าต้องถูกต้อง (เงินไม่ติดลบ, ชนิดตู้/จำนวนปลาไม่เกินความจุ ฯลฯ)
// - จุดสำรองสร้างได้อย่างเดียว แก้/ลบไม่ได้
//
// ข้อจำกัด: Rules พิสูจน์ไม่ได้ว่าการซื้อขายแต่ละครั้งถูกต้อง ผู้ที่รู้รหัสผ่านและเขียน Firestore เองยังแก้ค่าได้
// ภายในขอบเขตข้างต้น (ถ้าต้องการให้เซิร์ฟเวอร์ตรวจทุกการซื้อขาย ต้องใช้แผน Blaze: firestore.blaze.rules)
// deploy: npm run deploy (ตรวจว่าตั้ง UID แล้วก่อน deploy ทุกครั้ง)
service cloud.firestore {
  match /databases/{database}/documents {

    // UID ของบัญชีผู้เล่นหลัก (ไม่ใช่ความลับ) — ตั้งด้วยคำสั่ง: npm run set-player-uid -- <UID>
    // ค่าเริ่มต้นเป็นข้อความที่ไม่มีทางตรงกับ UID จริง → ถ้ายังไม่ตั้ง จะไม่มีใครอ่าน/เขียนเซฟได้เลย
    function playerUid() {
      return 'nkOplSQagocHBfkM5T4FPwp8OYB3';
    }


    // ต้องเป็นบัญชีหลัก และเข้าสู่ระบบด้วย Email/Password (ไม่รับ token แบบอื่น เช่น custom/anonymous)
    function isPlayer() {
      return request.auth != null
        && playerUid() != 'SET_PLAYER_UID_BEFORE_DEPLOY'
        && request.auth.uid == playerUid()
        && request.auth.token.firebase.sign_in_provider == 'password';
    }

    function isCount(v, max) {
      return v is int && v >= 0 && v <= max;
    }

    // ต้องตรงกับ capacity ใน src/data/tanks.js (tests/unit/tanks.test.js ตรวจให้)
    function tankCapacities() {
      return {'starter': 14, 'classic': 20, 'large': 28, 'panorama': 40,
        'sakura': 48, 'aurora': 56, 'cosmos': 64};
    }

    function validTank(t, capacities, allowedKeys) {
      let id = t.id;
      let cleanliness = t.cleanliness;
      let fish = t.fish;
      let decor = t.decor;
      // รวมผลเป็นลิสต์เพื่อลดนิพจน์ซ้ำ; key ที่ขาด/ชนิดตู้ที่ไม่มีใน capacities จะถูกปฏิเสธ
      return [t.keys().hasOnly(allowedKeys),
        id is string, id.size() <= 64,
        cleanliness is number, cleanliness >= 0, cleanliness <= 100,
        fish is list, fish.size() <= capacities[t.typeId],
        decor is list, decor.size() <= 150].hasOnly([true]);
    }

    // ฟังก์ชันตรวจข้างล่างรวมเงื่อนไขเป็นลิสต์ (แบบ validTank) เพื่อประหยัดงบนิพจน์ — ผิด/ขาด/error = ถูกปฏิเสธเหมือนใช้ &&
    function validInventory(inv) {
      return [inv.keys().hasOnly(['flakes', 'pellets', 'bloodworm', 'medicine']),
        isCount(inv.get('flakes', 0), 1000000),
        isCount(inv.get('pellets', 0), 1000000),
        isCount(inv.get('bloodworm', 0), 1000000),
        isCount(inv.get('medicine', 0), 1000000)].hasOnly([true]);
    }

    function validMissions(m) {
      return [m.keys().hasOnly(['day', 'progress', 'claimed']),
        m.day is string, m.day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'),
        m.progress is map, m.claimed is map].hasOnly([true]);
    }

    function validStats(s) {
      return [s.keys().hasOnly(['feeds', 'coinsCollected', 'fishBorn', 'fishBought']),
        isCount(s.feeds, 1000000000000),
        isCount(s.coinsCollected, 1000000000000),
        isCount(s.fishBorn, 1000000000000),
        isCount(s.fishBought, 1000000000000)].hasOnly([true]);
    }

    // กระถางทานตะวันข้างตู้ (src/shared/garden.js) — ไม่มีฟิลด์นี้ = ยังไม่ได้ปลูก
    function validSunflower(s) {
      return s.keys().hasOnly(['plantedAt', 'at', 'water', 'food', 'growth', 'health', 'seedsAt'])
        && s.water is number && s.health is number && s.growth is number;
    }

    function validGame(g) {
      let tanks = g.tanks;
      let tankCount = tanks.size();
      let capacities = tankCapacities();
      let tankKeys = ['id', 'typeId', 'name', 'cleanliness', 'fish', 'decor', 'lastUpdate'];
      // รวมเงื่อนไขเป็นลิสต์ (แบบเดียวกับ validTank) แทน && ยาว ๆ — ประหยัดงบนิพจน์ 1000 ตอนมีครบ 7 ตู้
      // ค่าใดผิด/ขาด/ผิดชนิด → ได้ false หรือ Rules error → ถูกปฏิเสธเหมือนเดิม
      return [g.keys().hasOnly(['version', 'coins', 'gems', 'inventory', 'selectedFood', 'collection', 'tanks', 'activeTankId',
          'missions', 'dailyRewardDay', 'lastCleanAt', 'stats', 'lastSaved', 'sunflower']),
        g.version == 1,
        isCount(g.coins, 1000000000),
        isCount(g.gems, 10000000),
        validInventory(g.inventory),
        g.selectedFood in ['flakes', 'pellets', 'bloodworm'],
        // เผื่อสายพันธุ์ที่เลิกขาย/ถอดออกแล้วแต่ยังค้างในสมุดสะสมของเซฟเดิม (เช่น ปลาอวกาศ) + สายพันธุ์ใหม่
        g.collection is map, g.collection.size() <= 64,
        tanks is list, tankCount >= 1, tankCount <= 7,
        validTank(tanks[0], capacities, tankKeys),
        tankCount < 2 || validTank(tanks[1], capacities, tankKeys),
        tankCount < 3 || validTank(tanks[2], capacities, tankKeys),
        tankCount < 4 || validTank(tanks[3], capacities, tankKeys),
        tankCount < 5 || validTank(tanks[4], capacities, tankKeys),
        tankCount < 6 || validTank(tanks[5], capacities, tankKeys),
        tankCount < 7 || validTank(tanks[6], capacities, tankKeys),
        g.activeTankId is string,
        validMissions(g.missions), validStats(g.stats),
        !('sunflower' in g) || validSunflower(g.sunflower)].hasOnly([true]);
    }

    function validMeta(m) {
      return m.keys().hasOnly(['writers', 'tanks', 'lastBackupDay'])
        && m.writers is map && m.writers.size() <= 500
        && m.tanks is map && m.tanks.size() <= 8;
    }

    function validSave(d) {
      return d.keys().hasOnly(['schemaVersion', 'revision', 'epoch', 'createdAt', 'updatedAt', 'updatedBy', 'game', 'meta'])
        && d.schemaVersion == 1
        && d.revision is int
        && d.epoch is int && d.epoch >= 0
        && (!('updatedBy' in d) || (d.updatedBy is string && d.updatedBy.size() <= 64))
        && d.updatedAt == request.time
        && validGame(d.game)
        && validMeta(d.meta);
    }

    function validWrite(d) {
      return validSave(d)
        && (request.method == 'create'
          ? (d.revision == 1 && d.epoch == 0 && d.createdAt == request.time)
          : validUpdate(d, resource.data));
    }

    function validUpdate(d, previous) {
      return d.revision == previous.revision + 1
        && d.createdAt == previous.createdAt
        && d.epoch - previous.epoch in [0, 1];
    }

    match /gameSaves/{saveId} {
      allow get: if saveId == 'global' && isPlayer();
      allow list: if false;

      // ตรวจโครงสร้างครั้งเดียวทั้ง create/update เพื่อไม่เกินงบนิพจน์เมื่อมีครบ 7 ตู้
      // สร้างครั้งแรก: revision = 1, epoch = 0 / บันทึกต่อ: revision + 1, epoch คงเดิมหรือ + 1
      allow create, update: if saveId == 'global' && isPlayer()
        && validWrite(request.resource.data);

      allow delete: if false;

      match /backups/{backupId} {
        allow read: if saveId == 'global' && isPlayer();
        allow create: if saveId == 'global' && isPlayer()
          && request.resource.data.keys().hasOnly(['createdAt', 'reason', 'revision', 'epoch', 'schemaVersion', 'by', 'summary', 'game'])
          && request.resource.data.createdAt == request.time
          && request.resource.data.reason in ['daily', 'manual', 'before-reset', 'before-restore', 'before-replace', 'before-migration']
          && request.resource.data.revision is int
          && request.resource.data.game is map;
        allow update, delete: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
